{"name":"velozity-project-dashboard","private":true,"workspaces":["api","web"],"scripts":{"start":"npm run dev","dev":"concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"","dev:api":"npm --workspace api run dev","dev:web":"npm --workspace web run dev","build":"npm --workspace api run build && npm --workspace web run build","db:up":"docker compose up -d db","db:migrate":"npm --workspace api run db:migrate --","db:seed":"npm --workspace api run db:seed"},"devDependencies":{"concurrently":"^9.1.2"}}
